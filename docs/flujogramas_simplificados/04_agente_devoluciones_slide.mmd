    F -->|"Faltan datos"| D
    F -->|"Revision humana"| H["Se escala a soporte"]
    F -->|"Rechazada"| I["Se explica la regla aplicada"]
    G --> J["Se registra la accion y se muestra SVG"]

    classDef user fill:#EEF6FF,stroke:#2F80ED,stroke-width:3px,color:#111827;
    classDef app fill:#EFFAF1,stroke:#27AE60,stroke-width:3px,color:#111827;
    classDef decision fill:#F4ECFF,stroke:#8E44AD,stroke-width:3px,color:#111827;
    classDef tool fill:#FFF3E8,stroke:#F2994A,stroke-width:3px,color:#111827;
    classDef warn fill:#FFF9E6,stroke:#F2C94C,stroke-width:3px,color:#111827;
    classDef stop fill:#FCEAF1,stroke:#EB5757,stroke-width:3px,color:#111827;
    class A user;
    class B,D,J app;
    class C,F decision;
    class E,G tool;
    class H warn;
    class I stop;
