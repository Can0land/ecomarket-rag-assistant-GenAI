%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial", "fontSize": "23px", "primaryColor": "#EEF6FF", "primaryBorderColor": "#2F80ED", "primaryTextColor": "#111827", "lineColor": "#111827", "tertiaryColor": "#FFFFFF"}, "flowchart": {"curve": "linear", "nodeSpacing": 44, "rankSpacing": 42}}}%%
flowchart TD
    A["Usuario solicita devolucion"] --> B["Se busca orden y producto"]
    B --> C{"Informacion completa?"}
    C -->|"No"| D["Se piden datos faltantes"]
    C -->|"Si"| E["Tool valida politica de devolucion"]
